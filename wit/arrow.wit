package arrow:plugin@0.10.0;

interface types {
    record selection {
        anchor: u32,
        /// The end that moves. Together with `anchor` it covers `min..=max`.
        cursor: u32,
    }

    /// Kinds of events a plugin can subscribe to.
    enum event-kind {
        /// All plugins have loaded.
        startup,
        /// The buffer text changed.
        buffer-changed,
        /// A dot moved, changed size, or dots were added or removed.
        selection-changed,
        /// The editor switched modes.
        mode-changed,
        /// A named command ran (from a key binding, the command menu or a plugin).
        command-executed,
    }

    variant event {
        startup,
        buffer-changed,
        /// Carries the primary dot.
        selection-changed(selection),
        mode-changed(string),
        command-executed(string),
        /// A program this plugin started (see the `process` interface) wrote
        /// something. Sent only to that plugin, which needn't subscribe. Edits
        /// made while handling it do trigger events, as a command's would.
        process-output(process-output),
        /// A program this plugin started has exited. Sent after all its output.
        process-exited(process-exit),
    }

    enum output-stream { stdout, stderr }

    record process-output {
        /// The id `spawn` returned.
        id: u32,
        %stream: output-stream,
        /// Bytes as the program wrote them, in chunks of any size. Text can be
        /// split mid-line, or mid-character in UTF-8, between chunks.
        data: list<u8>,
    }

    record process-exit {
        id: u32,
        /// The exit code, or none if the program was killed or its status
        /// couldn't be read.
        code: option<s32>,
    }

    /// One entry in a menu.
    record menu-item {
        /// Shown first, and what the typed input is matched against.
        label: string,
        /// Passed to the menu's `on-select` command when this item is chosen.
        value: string,
        /// Shown highlighted in its own column, e.g. a key binding or a
        /// completion kind ("fn", "struct"). May be empty.
        annotation: string,
        /// Shown dimmed after it, e.g. a description or a type signature. May
        /// be empty.
        detail: string,
    }

    /// A menu for the user to pick from, shown like Emacs's Vertico.
    record menu {
        /// Shown before the input, e.g. "M-x".
        prompt: string,
        /// Input to start with.
        input: string,
        /// In ranking order. Typing filters them (space-separated parts must all
        /// appear in the label, in any order); the order is kept, except that an
        /// exact match moves to the top.
        items: list<menu-item>,
        /// Command to run with the chosen item's `value` as its argument.
        on-select: string,
    }

    /// A registered command, as listed by `list-commands`.
    record command-info {
        name: string,
        description: string,
        /// Name of the plugin providing it, or "app" for the host's own commands.
        plugin: string,
        /// Its normal-mode key binding, if it has one, e.g. "<a-s>".
        binding: option<string>,
        /// Whether it waits for a typed character before running.
        takes-char: bool,
    }

    /// One node of a tree menu. WIT has no recursive types, so a tree is sent as
    /// a flat list in which each node names its parent.
    record tree-node {
        /// Shown in the menu.
        label: string,
        /// Identifies the node: other nodes name it as their parent, and it is
        /// passed to the menu's `on-select` or `on-expand` command.
        value: string,
        /// Shown in a column beside the label, e.g. a file size.
        annotation: string,
        /// Shown in the preview column when the node is a highlighted leaf.
        detail: string,
        /// `value` of the parent node, or none for a top-level node.
        parent: option<string>,
        /// Whether the node is a branch that has, or may have, children.
        branch: bool,
    }

    /// A tree for the user to browse, shown like the file manager ranger: the
    /// parent level, the current level and a preview of the highlighted node.
    record tree-menu {
        /// Shown in the header, before the path to the current level.
        title: string,
        /// Any number of levels. Branches whose children aren't listed are
        /// filled in on demand through `on-expand`.
        nodes: list<tree-node>,
        /// Command to run with a leaf's `value` when it is chosen.
        on-select: string,
        /// Command to run with a branch's `value` the first time its children are
        /// needed (when it is highlighted or entered). It should answer with
        /// `add-tree-nodes`. None means every branch is already complete.
        on-expand: option<string>,
    }

    /// An open buffer, as listed by `list-buffers`.
    record buffer-info {
        id: u32,
        /// Its name, e.g. a file path, or "*scratch*".
        name: string,
        /// Whether it is the current buffer, the one the editor shows.
        current: bool,
        /// Length in characters.
        len: u32,
        /// Whether its text differs from when it was opened or last written.
        modified: bool,
    }

    /// A key binding, as listed by `list-bindings`.
    record binding-info {
        mode: string,
        /// In Kakoune notation, e.g. "gh" or "<a-s>".
        keys: string,
        command: string,
    }
}

/// The editor's storage: its text, its dots and its mode.
///
/// The host only stores these and draws them. It has no editing behaviour of its
/// own: it doesn't move dots when the text changes, merge them, keep a final
/// newline or record undo history. That is all up to plugins (see the core
/// plugin). Its one rule is that dot positions are kept inside the text (pulled
/// back to the last character if needed), so the view can always draw them.
///
/// There can be several buffers open, each with its own text and dots; every
/// function here works on the current one. The mode is the editor's, shared by
/// all buffers.
///
/// Positions are character indices. Dots are the editor's cursors: each is a
/// selection covering `min(anchor, cursor)..=max(anchor, cursor)`. They are kept
/// in the order plugins set them, conventionally oldest first; the last one is
/// the primary dot, which the view follows. There is always at least one.
interface editor {
    use types.{selection, buffer-info};

    len: func() -> u32;
    char-at: func(index: u32) -> option<char>;
    /// Text in `start..end` (end exclusive).
    slice: func(start: u32, end: u32) -> string;
    /// Replace `start..end` (end exclusive) with `text`. Dots are not moved.
    replace: func(start: u32, end: u32, text: string);
    /// Replace `start..end` like `replace`, and shift every dot so it keeps
    /// pointing at the same text: dots after the change move by its size, and
    /// dot ends inside the replaced range move to its start. One call instead of
    /// `get-dots`, `replace` and `set-dots`, which matters with many dots.
    edit: func(start: u32, end: u32, text: string);

    /// Start of the line containing `index` (past the end: `index`).
    line-start: func(index: u32) -> u32;
    /// The newline ending the line containing `index` (on the last character or
    /// past it: `index`). Both are O(log n), unlike scanning with `char-at`.
    line-end: func(index: u32) -> u32;
    /// Which line `index` is on, from 0: the number of newlines before it.
    line-index: func(index: u32) -> u32;

    /// Save the current buffer's text and dots, for undo, and return an id for
    /// the copy. This is cheap however big the buffer is: the copy shares the
    /// text with the buffer until either is edited. Drop it when done with it.
    take-snapshot: func() -> u32;
    /// Put the current buffer back as it was in a snapshot. False if the
    /// snapshot is gone or belongs to another buffer.
    restore-snapshot: func(id: u32) -> bool;
    /// Whether the current buffer's text differs from a snapshot's. Usually
    /// answered without comparing any text. A missing snapshot counts as changed.
    changed-since: func(id: u32) -> bool;
    drop-snapshot: func(id: u32);

    /// All dots, in order.
    get-dots: func() -> list<selection>;
    /// Replace every dot. An empty list is ignored.
    set-dots: func(dots: list<selection>);
    get-dot: func(index: u32) -> option<selection>;
    set-dot: func(index: u32, selection: selection);
    /// The primary (last) dot.
    get-selection: func() -> selection;
    set-selection: func(selection: selection);

    get-mode: func() -> string;
    /// Switch to a mode created with `define-mode`.
    set-mode: func(mode: string) -> result<_, string>;

    /// The name shown in the status bar, e.g. a file path. Starts as "*scratch*".
    get-buffer-name: func() -> string;
    set-buffer-name: func(name: string);

    /// Open a buffer named `name` holding `text`, make it current and return
    /// its id. If a buffer with that name is already open, switch to it instead
    /// and keep its text (and any unsaved edits); `text` is ignored.
    open-buffer: func(name: string, text: string) -> u32;
    /// Make the buffer with this id current. Returns false if there is none.
    switch-buffer: func(id: u32) -> bool;
    /// Close a buffer, discarding its text. Closing the current buffer makes
    /// the most recently opened other buffer current. The last buffer can't be
    /// closed. Ids aren't reused.
    close-buffer: func(id: u32) -> result<_, string>;
    /// The current buffer's id. The buffer the editor starts with is 0.
    get-buffer-id: func() -> u32;
    /// Every open buffer, in the order they were opened.
    list-buffers: func() -> list<buffer-info>;

    /// Show a message in the status bar until the next key press.
    message: func(text: string);

    /// Run any command by name after the current plugin call returns, with an
    /// optional argument. Returns false if no command has that name. A
    /// `takes-char` command run without an argument waits for a typed character.
    ///
    /// Besides plugin commands, the host has its own: `quit`, and `write`, which
    /// saves the current buffer to the file it is named after (or to the path in
    /// `arg`, renaming the buffer). Only files inside the working directory can
    /// be written; plugins can't write files themselves.
    run-command: func(name: string, arg: option<string>) -> bool;
}

/// Adding modes, commands, key bindings and event hooks.
interface registry {
    use types.{event-kind, command-info, binding-info};

    /// Create a mode, or change its fallback. Characters typed in the mode with
    /// no binding run `fallback` with the character (e.g. self-insert); modes
    /// with a fallback draw a typing cursor. The editor starts in "normal".
    define-mode: func(name: string, fallback: option<string>);

    /// Add a command to the command menu. When it runs, the host calls this
    /// plugin's `run-command`. If `takes-char` is set, the host first waits for a
    /// typed character and passes it as the argument (like Kakoune's `r`).
    /// Registering an existing name replaces it.
    register-command: func(name: string, description: string, takes-char: bool);

    /// Bind a key sequence to any command, in Kakoune notation: "gh", "<a-s>",
    /// "<space>d", "<esc>". Rebinding a sequence replaces it.
    bind-key: func(mode: string, keys: string, command: string) -> result<_, string>;

    /// Label a prefix key for the status-bar hint, e.g. "g" -> "goto".
    name-prefix: func(mode: string, keys: string, label: string) -> result<_, string>;

    /// Have `on-event` called for every event of this kind.
    subscribe: func(event: event-kind);

    /// Every command that can be run, from all plugins and the app, by name.
    list-commands: func() -> list<command-info>;

    /// Every key binding in every mode, in the order they were bound.
    list-bindings: func() -> list<binding-info>;
}

/// Running other programs and talking to them through their standard input and
/// output: a proof assistant, a REPL, a compiler, a language server.
///
/// A plugin may only start programs it has been allowed to. Bundled plugins
/// are allowed theirs by the host; others are listed in `plugins.toml` in the
/// user config directory:
///
///     [plugins.<plugin file name, without .wasm>]
///     run = ["coqtop", "lean"]    # or ["*"] for any program
///
/// A bare name like "coqtop" allows that program as found on the PATH, and only
/// when the plugin asks for it by bare name. A path allows exactly that file.
///
/// Output arrives later, as `process-output` events, and then one
/// `process-exited`, delivered only to the plugin that called `spawn`. Writing
/// never blocks: the host queues the bytes and feeds them to the program.
interface process {
    record command {
        /// The program: a name to look up on the PATH, or a path.
        program: string,
        args: list<string>,
        /// Working directory. None: the directory Arrow was started in.
        cwd: option<string>,
        /// Extra environment variables, on top of Arrow's own.
        env: list<tuple<string, string>>,
    }

    /// Start a program with its stdin, stdout and stderr connected to this
    /// plugin. Returns an id for the other functions and for the events.
    spawn: func(command: command) -> result<u32, string>;
    /// Queue bytes for the program's standard input.
    write: func(id: u32, data: list<u8>) -> result<_, string>;
    /// Close the program's standard input, as end-of-file, once queued bytes
    /// have been written.
    close-stdin: func(id: u32);
    /// Stop the program. Its `process-exited` event still follows.
    kill: func(id: u32);
}

/// The host's user interface.
interface ui {
    use types.{menu, tree-menu, tree-node};

    /// Show a menu once the current plugin call returns, replacing any open menu
    /// or tree menu. Choosing an item runs the menu's `on-select` command with
    /// its value; Escape closes it without running anything.
    open-menu: func(menu: menu);

    /// Show a tree menu once the current plugin call returns, replacing any open
    /// menu or tree menu. Choosing a leaf runs its `on-select` command with the
    /// leaf's value; Escape closes it.
    open-tree-menu: func(menu: tree-menu);

    /// Add children to the open tree menu, usually in answer to `on-expand`.
    /// `parent` is the branch being filled in (none for the top level); it is
    /// marked complete even if `nodes` is empty. Nodes already present are kept.
    add-tree-nodes: func(parent: option<string>, nodes: list<tree-node>);
}

world plugin {
    import editor;
    import registry;
    import ui;
    import process;
    use types.{event};

    /// Called once when the plugin loads. Register modes, commands, keys and
    /// hooks here.
    export init: func();

    /// Run one of the commands this plugin registered. `arg` is the typed
    /// character for `takes-char` commands, the chosen item's value for a menu's
    /// `on-select` command, or what another plugin passed to `run-command`.
    export run-command: func(name: string, arg: option<string>);

    /// Called for each event the plugin subscribed to. Edits made here don't
    /// trigger further events.
    export on-event: func(event: event);
}
